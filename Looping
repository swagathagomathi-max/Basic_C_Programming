Find the factorial of a number

#include <stdio.h>

void main()
{
    int num,fact=1;
    printf("Enter the number:");
    scanf("%d",&num);
    for(int i = 1;i<=num;i++)
    {
        fact = fact*i;
    }
    printf("Factorial:%d",fact);
}

--------------------------------------------------------------------

Reverse a number

#include <stdio.h>

void main()
{
    int num,rev=0;
    printf("Enter the number:");
    scanf("%d",&num);
    while(num!=0)
    {
        rev=rev*10;
        rev=rev+num%10;
        num=num/10;
    }
    printf("The reverse number:%d",rev);
}

