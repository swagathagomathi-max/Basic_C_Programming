Read marks of 5 subjects and calculate total and average.

#include <stdio.h>

void main()
{
    int m1,m2,m3,m4,m5;
    float total=0,avg=0;
    printf("Enter 5 Subjects marks:");
    scanf("%d %d %d %d %d",&m1,&m2,&m3,&m4,&m5);
    total = m1+m2+m3+m4+m5;
    avg = total/5;
    printf("Total:%.2f\n",total);
    printf("Average:%.2f\n",avg);
}

