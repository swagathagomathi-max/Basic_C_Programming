Swap two numbers using a third variable.

#include <stdio.h>

void main()
{
    int a = 20, b = 10,temp;
    temp = a;
    a = b;
    b = temp;
    printf("Value of a:%d\n",a);
    printf("Value of b:%d\n",b);
}

--------------------------------------------------------------------------------------

Swap two numbers without using a third variable.

#include <stdio.h>

void main()
{
    int a = 20, b = 10,temp;
    a = a+b;
    b = a-b;
    a = a-b;
    printf("Value of a:%d\n",a);
    printf("Value of b:%d\n",b);
}

