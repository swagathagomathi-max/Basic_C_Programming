2. Read the radius of a circle and find its area and circumference.

#include <stdio.h>

int r,pi=3.14;

void main()
{
    printf("Enter radius of circle:");
    scanf("%d",&r);
    printf("Area of the circle:%d\n",pi*r*r);
    printf("Circumference of the circle:%d\n",2*pi*r);
    
}

