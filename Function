Write a function to find the square of a number.

#include <stdio.h>
void square(int);

void main()
{
    int num;
    printf("Enter number:");
    scanf("%d",&num);
    square(num);
}

void square(int num)
{
    printf("Square of the number: %d",num*num);
}

