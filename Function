Write a function to find the largest of three numbers.


#include <stdio.h>

void largest(int,int,int);

void main()
{
    int n1,n2,n3;
    printf("Enter three number:");
    scanf("%d %d %d",&n1,&n2,&n3);
    largest(n1,n2,n3);
}

void largest(int n1, int n2, int n3)
{
    if(n1>n2 && n1>n3)
    {
        printf("The largest number is %d",n1);
    }
    else if(n2>n3)
    {
        printf("The largest number is %d",n2);
    }
    else
    {
        printf("The largest number is %d",n3);
    }
}

