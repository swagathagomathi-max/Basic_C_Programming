Read a number and find whether it is positive,negative or zero

#include <stdio.h>

void main()
{
    int num;
    printf("Enter the number:");
    scanf("%d",&num);
    if(num>0)
    {
        printf("The number is positive");
    }
    else if(num<0)
    {
        printf("The number is negative");
    }
    else
    {
        printf("The number is zero");
    }
    
}

