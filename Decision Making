Create a simple caluculator using switch

#include <stdio.h>

void main()
{
    int num,a,b;
    printf("Enter value of a and b:");
    scanf("%d %d",&a,&b);
    printf("1.Addition\n");
    printf("2.Subtraction\n");
    printf("3.Multiplication\n");
    printf("4.Division\n");
    printf("5.Modulus\n");
    printf("Enter number for calculation:");
    scanf("%d",&num);
    switch(num)
    {
        case 1:
        printf("Addition of two numbers:%d",a+b);
        break;
        case 2:
        printf("Subtraction of two numbers:%d",a-b);
        break;
        case 3:
        printf("Multiplication of two numbers:%d",a*b);
        break;
        case 4:
        printf("Division of two numbers:%d",a/b);
        break;
        case 5:
        printf("Modulus of two numbers:%d",a%b);
        break;
        default:
        printf("Invalid input");
        break;
    }
    
}

