Read marks and display grade

#include <stdio.h>

void main()
{
    int marks;
    printf("Enter your mark:");
    scanf("%d",&marks);
    if(marks>=90 && marks <=100)
    {
        printf("Grade A");
    }
    else if(marks>=80 && marks <=89)
    {
        printf("Grade B");
    }
    else if(marks>=70 && marks <=79)
    {
        printf("Grade C");
    }
    else if(marks>=60 && marks <=69)
    {
        printf("Grade D");
    }
    else
    {
        printf("Grade F");
    }
    
}

