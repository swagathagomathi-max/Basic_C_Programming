Find the largest element in an array.

#include<stdio.h>

void main()
{
    int arr[5];
    int max=arr[0];
    printf("Enter array elements:");
    for(int i=0;i<5;i++)
    {
        scanf("%d",&arr[i]);
        if(arr[i]>max)
        {
            max=arr[i];
        }
    }
    printf("The largest element:%d",max);
}

