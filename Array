Search for an element in an array.

#include <stdio.h>

void main()
{
    int arr[5],num,count=0;
    printf("Enter the array elements:");
    for(int i=0;i<5;i++)
    {
        scanf("%d",&arr[i]);
    }
    printf("Enter number to search:");
    scanf("%d",&num);
    for(int i=0;i<5;i++)
    {
        if(arr[i]==num)
        {
            count++;
        }
    }
    if(count==1)
    {
        printf("The element is in the array");
    }
    else
    {
        printf("The element is not in the array");
    }
    
}

