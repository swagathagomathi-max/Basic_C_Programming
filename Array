Reverse the elements of an array.

#include <stdio.h>

void main()
{
    int arr[5],rev[5],j=0;
    printf("Enter the array elements:");
    for(int i=0;i<5;i++)
    {
        scanf("%d",&arr[i]);
    }
    for(int i=4;i>=0;i--)
    {
        rev[j]=arr[i];
        j++;
    }
    printf("The reverse array elements:");
    for(int j=0;j<5;j++)
    {
        printf("%d ",rev[j]);
    }
}

