Find the smallest element in an array.

#include<stdio.h>

void main()
{
    int arr[5];
    printf("Enter array elements:");
    for(int i=0;i<5;i++)
    {
        scanf("%d",&arr[i]);
    }
    int min=arr[0];
    for(int i=0;i<5;i++)
    {
        if(arr[i]<min)
        {
            min=arr[i];
        }
    }
    printf("The smallest element:%d",min);
}
