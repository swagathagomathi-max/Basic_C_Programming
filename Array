Find the second largest element in an array.

#include <stdio.h>

void main()
{
    int arr[5];
    printf("Enter the array elements:");
    for(int i=0;i<5;i++)
    {
        scanf("%d",&arr[i]);
    }
    int largest = arr[0];
    int secondLargest = arr[0];

    for (int i = 1; i < 5; i++)
    {
        if (arr[i] > largest)
        {
            secondLargest = largest;
            largest = arr[i];
        }
        else if (arr[i] > secondLargest && arr[i] != largest)
        {
            secondLargest = arr[i];
        }
    }

    printf("Second largest = %d", secondLargest);

}

