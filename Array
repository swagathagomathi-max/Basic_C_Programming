Count the number of even and odd elements in an array.

#include <stdio.h>

void main()
{
    int arr[5];
    printf("Enter the array elements:");
    for(int i=0;i<5;i++)
    {
        scanf("%d",&arr[i]);
    }
    int even=0,odd=0;
    for(int i=0;i<5;i++)
    {
        if(arr[i]%2==0)
        {
            even++;
        }
        else
        {
            odd++;
        }
    }
    printf("The number of even number is %d\n",even);
    printf("The number of odd number is %d\n",odd);
}

