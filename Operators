Read a three-digit number and find the sum of its digits

#include <stdio.h>

void main()
{
    int num,hundred,ten,ones;
    printf("Enter three digit number:");
    scanf("%d",&num);
    hundred = num/100;
    ten = (num/10)%10;
    ones = num%10;
    printf("Sum of its digits:%d",hundred+ten+ones);
}

