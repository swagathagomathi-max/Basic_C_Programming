Read an integer and find whether it is odd or even using the modulus operator

#include <stdio.h>

void main()
{
    int num;
    printf("Enter the number:");
    scanf("%d",&num);
    if(num%2==0)
    {
        printf("The number is even");
    }
    else
    {
        printf("The number is odd");
    }
}

